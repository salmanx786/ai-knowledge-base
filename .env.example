# ---------------------------------------------------------------------------
# Application settings (read by app.config.settings via pydantic-settings).
# ---------------------------------------------------------------------------

# SQLAlchemy async URL. The driver MUST be asyncpg.
#   Local (bare metal):   postgresql+asyncpg://user:password@localhost:5432/ai_knowledge_base
#   Docker Compose:       leave this as-is for local dev; docker-compose.yml
#                         overrides DATABASE_URL to point at the `postgres`
#                         service automatically.
#   Koyeb:                set DATABASE_URL to your managed Postgres URL and be
#                         sure it uses the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_knowledge_base

JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Filesystem root for uploaded documents (created on first upload).
#   Local:  uploads
#   Docker: /app/uploads  (backed by the `uploads_data` volume)
UPLOAD_DIR=uploads

# Port uvicorn binds to. Koyeb injects PORT automatically; set it only if you
# need a non-default local port.
PORT=8000

# Google Gemini (RAG chat). GEMINI_API_KEY is optional at startup: the app boots
# without it, but calling POST /api/v1/chat without it returns a server error.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Docker Compose only — consumed by docker-compose.yml (NOT by the app).
# These provision the local `postgres` service and build its DATABASE_URL.
# ---------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=ai_knowledge_base
